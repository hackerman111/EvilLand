+    CWindowRule disabled;
+    ASSERT_TRUE(disabled.addEffect(WINDOW_RULE_EFFECT_HIDE_FROM_SCREEN_SHARE, "off"));
+    EXPECT_FALSE(std::get<bool>(disabled.effects()[0].value));
+}
