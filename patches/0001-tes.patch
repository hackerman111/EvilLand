+    EXPECT_TRUE(std::get<bool>(rule.effects()[0].value));
+    EXPECT_FALSE(std::get<bool>(rule.effects()[1].value));
+    EXPECT_EQ(windowEffects()->get("hide_from_screen_share"), WINDOW_RULE_EFFECT_HIDE_FROM_SCREEN_SHARE);
